# Public site URL used for canonical, sitemap, and OpenGraph tags.
# Change this to your real production domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://caffienatedweb.com

# Google Search Console verification token.
# Search Console > Settings > Ownership verification > HTML tag.
# Paste ONLY the content value of the meta tag, e.g. abcDEF... (not the full tag).
# Leave empty until you have it; the tag only renders when this is set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
